---
import Base from "../../layouts/Base.astro";
import "../../styles/lab.css";
---

<Base title="IK Lab · kakap.io" description="A fish built from an IK chain, with a FABRIK reach mode and a live skeleton overlay.">
  <canvas id="tank" aria-label="A fish built from an IK chain. It follows your pointer or finger."></canvas>

  <div id="hud">
    <a class="back" href="/">← kakap.io</a>
    <h1>IK Lab</h1>
    <p id="modeText"></p>
    <dl id="stats"></dl>
  </div>

  <details id="panel" open>
    <summary>Controls</summary>
    <div class="rows">
      <div class="seg" role="radiogroup" aria-label="Mode">
        <input type="radio" name="mode" id="mode-swim" value="swim" checked /><label for="mode-swim">Swim</label>
        <input type="radio" name="mode" id="mode-reach" value="reach" /><label for="mode-reach">Reach (FABRIK)</label>
      </div>
      <div class="seg" role="radiogroup" aria-label="Body">
        <input type="radio" name="body" id="body-blocks" value="blocks" checked /><label for="body-blocks">Blocks</label>
        <input type="radio" name="body" id="body-outline" value="outline" /><label for="body-outline">Outline</label>
      </div>
      <label class="check"><input type="checkbox" id="skeleton" checked /> Show IK skeleton and bend limits</label>

      <div class="slider">
        <label for="s-segments">Segments</label><output for="s-segments"></output>
        <input type="range" id="s-segments" data-key="segments" min="3" max="28" step="1" />
      </div>
      <div class="slider">
        <label for="s-segmentLength">Segment length</label><output for="s-segmentLength"></output>
        <input type="range" id="s-segmentLength" data-key="segmentLength" min="6" max="32" step="1" />
      </div>
      <div class="slider">
        <label for="s-maxBendDeg">Max bend per joint</label><output for="s-maxBendDeg"></output>
        <input type="range" id="s-maxBendDeg" data-key="maxBendDeg" min="3" max="90" step="1" />
      </div>
      <div class="slider">
        <label for="s-bodyWidth">Body width</label><output for="s-bodyWidth"></output>
        <input type="range" id="s-bodyWidth" data-key="bodyWidth" min="10" max="60" step="1" />
      </div>
      <div class="slider">
        <label for="s-speed">Speed</label><output for="s-speed"></output>
        <input type="range" id="s-speed" data-key="speed" min="40" max="420" step="10" />
      </div>
      <div class="slider">
        <label for="s-turnRateDeg">Turn rate</label><output for="s-turnRateDeg"></output>
        <input type="range" id="s-turnRateDeg" data-key="turnRateDeg" min="30" max="720" step="10" />
      </div>
      <div class="slider">
        <label for="s-wiggle">Swim wiggle</label><output for="s-wiggle"></output>
        <input type="range" id="s-wiggle" data-key="wiggle" min="0" max="1" step="0.05" />
      </div>

      <button id="reset" type="button">Reset to defaults</button>
      <p class="hint">Move the mouse, or touch and drag. With no input for 2.5 s, the target wanders by itself.</p>
    </div>
  </details>
</Base>

<script>
  import "../../tank/lab";
</script>
