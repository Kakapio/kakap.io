---
import Base from "../../layouts/Base.astro";
---

<Base title="IK Lab · kakap.io" description="A fish built from an IK chain, with a FABRIK reach mode and a live skeleton overlay.">
  <canvas id="tank" aria-label="A fish built from an IK chain. It follows your pointer or finger."></canvas>

  <div id="hud">
    <a class="back" href="/">← kakap.io</a>
    <h1>IK Lab</h1>
    <p id="modeText"></p>
    <dl id="stats"></dl>
  </div>

  <details id="panel" open>
    <summary>Controls</summary>
    <div class="rows">
      <div class="seg" role="radiogroup" aria-label="Mode">
        <input type="radio" name="mode" id="mode-swim" value="swim" checked /><label for="mode-swim">Swim</label>
        <input type="radio" name="mode" id="mode-reach" value="reach" /><label for="mode-reach">Reach (FABRIK)</label>
      </div>
      <div class="seg" role="radiogroup" aria-label="Body">
        <input type="radio" name="body" id="body-blocks" value="blocks" checked /><label for="body-blocks">Blocks</label>
        <input type="radio" name="body" id="body-outline" value="outline" /><label for="body-outline">Outline</label>
      </div>
      <label class="check"><input type="checkbox" id="skeleton" checked /> Show IK skeleton and bend limits</label>

      <div class="slider">
        <label for="s-segments">Segments</label><output for="s-segments"></output>
        <input type="range" id="s-segments" data-key="segments" min="3" max="28" step="1" />
      </div>
      <div class="slider">
        <label for="s-segmentLength">Segment length</label><output for="s-segmentLength"></output>
        <input type="range" id="s-segmentLength" data-key="segmentLength" min="6" max="32" step="1" />
      </div>
      <div class="slider">
        <label for="s-maxBendDeg">Max bend per joint</label><output for="s-maxBendDeg"></output>
        <input type="range" id="s-maxBendDeg" data-key="maxBendDeg" min="3" max="90" step="1" />
      </div>
      <div class="slider">
        <label for="s-bodyWidth">Body width</label><output for="s-bodyWidth"></output>
        <input type="range" id="s-bodyWidth" data-key="bodyWidth" min="10" max="60" step="1" />
      </div>
      <div class="slider">
        <label for="s-speed">Speed</label><output for="s-speed"></output>
        <input type="range" id="s-speed" data-key="speed" min="40" max="420" step="10" />
      </div>
      <div class="slider">
        <label for="s-turnRateDeg">Turn rate</label><output for="s-turnRateDeg"></output>
        <input type="range" id="s-turnRateDeg" data-key="turnRateDeg" min="30" max="720" step="10" />
      </div>
      <div class="slider">
        <label for="s-wiggle">Swim wiggle</label><output for="s-wiggle"></output>
        <input type="range" id="s-wiggle" data-key="wiggle" min="0" max="1" step="0.05" />
      </div>

      <button id="reset" type="button">Reset to defaults</button>
      <p class="hint">Move the mouse, or touch and drag. With no input for 2.5 s, the target wanders by itself.</p>
    </div>
  </details>
</Base>

<style is:global>
  html,
  body {
    overflow: hidden;
  }
  #tank {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: crosshair;
  }
  #hud {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 14px);
    left: calc(env(safe-area-inset-left, 0px) + 16px);
    max-width: min(380px, calc(100vw - 32px));
    pointer-events: none;
    display: grid;
    gap: 6px;
  }
  #hud .back {
    pointer-events: auto;
    justify-self: start;
    font-family: var(--mono);
    font-size: 12px;
    text-decoration: none;
  }
  #hud h1 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
  }
  #modeText {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
    text-wrap: pretty;
  }
  #stats {
    margin: 2px 0 0;
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    column-gap: 12px;
    row-gap: 2px;
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  #stats dt {
    color: var(--muted);
  }
  #stats dd {
    margin: 0;
  }
  #stats .hot {
    color: var(--amber);
  }

  #panel {
    position: fixed;
    right: calc(env(safe-area-inset-right, 0px) + 16px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
    width: 290px;
    max-height: calc(100% - 150px);
    overflow: auto;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @media (max-width: 600px) {
    #panel {
      left: calc(env(safe-area-inset-left, 0px) + 12px);
      right: calc(env(safe-area-inset-right, 0px) + 12px);
      bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
      width: auto;
      max-height: 55vh;
    }
  }
  #panel summary {
    list-style: none;
    cursor: pointer;
    padding: 11px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 14px;
  }
  #panel summary::-webkit-details-marker {
    display: none;
  }
  #panel summary::after {
    content: "+";
    font-family: var(--mono);
    color: var(--muted);
  }
  #panel[open] summary::after {
    content: "–";
  }
  #panel .rows {
    display: grid;
    gap: 14px;
    padding: 2px 14px 14px;
  }
  #panel .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  #panel .seg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  #panel .seg label {
    padding: 7px 8px;
    text-align: center;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
  }
  #panel .seg input:checked + label {
    background: rgba(238, 138, 92, 0.22);
    color: var(--ink);
  }
  #panel .seg input:focus-visible + label {
    outline: 2px solid var(--coral);
    outline-offset: -2px;
  }
  #panel .slider {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 8px;
    align-items: baseline;
  }
  #panel .slider label {
    font-size: 13px;
  }
  #panel .slider output {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  #panel .slider input {
    grid-column: 1 / -1;
    width: 100%;
    margin: 0;
    accent-color: var(--coral);
  }
  #panel .check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    cursor: pointer;
  }
  #panel .check input {
    accent-color: var(--coral);
    width: 16px;
    height: 16px;
    margin: 0;
  }
  #reset {
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 7px 10px;
    cursor: pointer;
  }
  #reset:hover {
    border-color: var(--muted);
  }
  #panel .hint {
    margin: 0;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }
</style>

<script>
  import "../../tank/lab";
</script>
